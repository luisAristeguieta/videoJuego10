# =============== #
# Unity .gitignore #
# =============== #

# Archivos y carpetas generados automáticamente por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Cache y aceleradores
.utmp/
.gradle/

# Archivos de soluciones de Visual Studio / JetBrains Rider / VS Code
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Configuración de entornos de desarrollo (IDE)
.vs/
.idea/
.vscode/

# Reportes de crash y volcados de memoria
sysinfo.txt
crashlytics-build.properties

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Archivos de soluciones y configuración de Visual Studio
*.slnx
.vsconfig
